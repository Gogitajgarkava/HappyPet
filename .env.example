# HappyPet Docker stack - local development defaults.
# Copy this file to .env and change every secret before using it outside local development.

# PostgreSQL
POSTGRES_DB=HappyPetDb
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST_PORT=5434

# Mailpit
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025

# LocalStack S3
S3_ACCESS_KEY=test
S3_SECRET_KEY=test
S3_BUCKET=happypet
S3_API_PORT=4566
S3_REGION=eu-central-1

# API
API_HOST_PORT=7149
FRONTEND_ORIGIN_HTTP=http://localhost:5173
FRONTEND_ORIGIN_HTTPS=https://localhost:5173
FRONTEND_ORIGIN_ALT=http://localhost:3000

# JWT - each value must be at least 32 characters
JWT_SECRET=dev-only-happypet-jwt-secret-0123456789abcdef
JWT_ISSUER=HappyPetApi
JWT_AUDIENCE=HappyPetClient
JWT_ACCESS_TOKEN_MINUTES=15
JWT_REFRESH_TOKEN_DAYS=30
JWT_REFRESH_TOKEN_HASH_KEY=dev-only-happypet-refresh-hash-key-0123456789abcdef

# OTP - at least 32 characters
OTP_HASH_KEY=dev-only-happypet-otp-hash-key-0123456789abcdef

# Mailpit accepts any SMTP credentials locally.
EMAIL_FROM=noreply@happypet.local
EMAIL_SMTP_USER=dev
EMAIL_SMTP_PASSWORD=dev
